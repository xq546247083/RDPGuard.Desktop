<UserControl x:Class="RDPGuard.View.TrayPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:convert="clr-namespace:RDPGuard.Convert"
             mc:Ignorable="d">

    <UserControl.Resources>
        <convert:ResultToBrushConverter x:Key="ResultToBrushConverter" />
        <convert:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border CornerRadius="8"
            Background="#FFFFFF"
            Width="280"
            Height="Auto">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="1"
                              Opacity="0.3"
                              Color="#333333" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Margin="14,10,14,8" Background="Transparent" Cursor="Hand" ToolTip="点击打开主控制台">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding OpenMainWindowCommand}" />
                </Grid.InputBindings>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Canvas Width="1024" Height="1024">
                            <Path Fill="#920783" Data="M754.74122089 512V359.23340839c0-15.22229397-12.50402729-27.72632126-27.72632045-27.72632045-50.0161083 0-97.85760342-19.57152036-133.19507125-54.90898901L531.2996936 214.07796417c-5.43653339-5.43653339-12.50402729-8.15480008-19.57152036-8.1548009v306.07683673h243.01304764z"/>
                            <Path Fill="#601986" Data="M268.71512561 512v63.06378827c0 64.69474878 25.55170725 126.12757736 71.21858918 171.79445929 47.29784162 47.29784162 109.8179772 71.21858918 171.79445845 71.21858917V512H268.71512561z"/>
                            <Path Fill="#601986" Data="M827.59076975 536.46440107c-13.59133347 0-24.46440107-10.87306677-24.46440024-24.46440107V314.11018078c0-6.52384039-4.89287989-11.41672027-11.41672028-11.4167211-71.76224268 0-139.17525732-27.72632126-189.73501996-78.82973575l-81.54800244-81.54800243c-3.26192019-2.71826669-6.52384039-3.26192019-8.69845359-3.26192021C498.13683979 139.05380129 487.26377218 128.18073452 487.26377218 114.58940106S498.13683979 90.125 511.72817324 90.125c16.30960016 0 30.98824063 6.52384039 42.40496174 17.39690717l81.54800244 81.54800243c41.31765472 41.31765472 96.77029642 64.15109528 155.48485831 64.15109528 33.16285464 0 60.34552158 27.18266775 60.34552158 60.34552241v197.8898192c0.5436535 14.13498697-10.32941327 25.00805374-23.92074756 25.00805458z"/>
                            <Path Fill="#920783" Data="M511.72817324 933.875c-90.79010952 0-176.14368567-35.33746783-240.29478093-99.48856311C207.28229702 769.69168811 171.9448292 684.33811197 171.9448292 593.54800244V314.11018078c0-33.16285464 27.18266775-60.34552158 60.34552157-60.3455224 58.71456189 0 114.16720358-22.83344055 155.48485831-64.15109527l81.54800326-81.54800244C480.73993261 96.64884039 495.96222577 90.125 511.72817324 90.125c16.30960016 0 30.98824063 6.52384039 42.40496174 17.39690717l81.54800244 81.54800243c41.31765472 41.31765472 96.77029642 64.15109528 155.48485831 64.15109528 33.16285464 0 60.34552158 27.18266775 60.34552158 60.34552241v197.8898192c0.5436535 14.13498697-10.32941327 25.00805374-23.92074756 25.00805458z"/>
                            <Path Fill="#601986" Data="M511.72817324 933.875c-13.59133347 0-24.46440107-10.87306677-24.46440106-24.46440107s10.87306677-24.46440107 24.46440106-24.46440022c77.74242874 0 150.59197842-30.44458795 206.04462013-85.35357615 54.90898819-54.90898819 85.35357614-128.30219055 85.35357614-206.04462012v-81.54800244c0-13.59133347 10.87306677-24.46440107 24.46440024-24.46440107s24.46440107 10.87306677 24.46440106 24.46440107v82.09165594c0 90.79010952-35.33746783 176.14368567-99.48856312 240.29478095-64.69474878 64.15109528-150.04832492 99.48856311-240.83843445 99.48856311z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="RDP 远程监控防护"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0" />

            <!-- 中间：状态看板 -->
            <Grid Grid.Row="1" Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="6" Padding="8" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="已封禁恶意 IP" FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BannedCount}" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="6" Padding="8" Margin="5,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="今日登录尝试" FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayAttemptsCount}" FontSize="18" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最近记录列表 -->
            <StackPanel Grid.Row="2" Margin="14,0,14,10">
                <TextBlock Text="最新远程登录事件" FontSize="12" FontWeight="SemiBold" Foreground="#777777" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding RecentRecords}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFAFA" CornerRadius="4" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{Binding IsSuccess, Converter={StaticResource ResultToBrushConverter}}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IpAddress}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="10" Foreground="#888888">
                                            <Run Text="{Binding UserName}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding FailureReason}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                               FontSize="10"
                                               Foreground="#999999"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="暂无登录记录"
                           FontSize="12"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,8"
                           Visibility="{Binding RecentRecords.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentRecords.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Separator Grid.Row="2" VerticalAlignment="Bottom" Margin="0" />

            <!-- 底部操作：退出 -->
            <StackPanel Grid.Row="3" Margin="8,4,8,8">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ExitCommand}"
                        HorizontalContentAlignment="Left"
                        MinHeight="36"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ExitToApp"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="退出" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
