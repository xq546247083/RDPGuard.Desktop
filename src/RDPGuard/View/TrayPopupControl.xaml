                            <Path Fill="{DynamicResource Brush.Brand.Primary}" Data="M511.72817324 933.875c-90.79010952 0-176.14368567-35.33746783-240.29478093-99.48856311C207.28229702 769.69168811 171.9448292 684.33811197 171.9448292 593.54800244V314.11018078c0-33.16285464 27.18266775-60.34552158 60.34552157-60.3455224 58.71456189 0 114.16720358-22.83344055 155.48485831-64.15109527l81.54800326-81.54800244C480.73993261 96.64884039 495.96222577 90.125 511.72817324 90.125 525.31950672 90.125 536.19257431 100.99806677 536.19257431 114.58940106S525.31950672 139.05380129 511.72817324 139.05380129c-1.63095968 0-4.89287989 0.5436535-8.15480007 3.26192021l-81.54800244 81.54800243C371.46560892 274.96713926 304.05259344 302.69345968 232.29035078 302.69345968c-6.52384039 0-11.41672027 4.89287989-11.41672029 11.4167211v279.43782166c0 77.74242874 30.44458795 150.59197842 85.35357614 206.04462012s128.30219055 85.35357614 206.04462013 85.35357615c13.59133347 0 24.46440107 10.87306677 24.46440106 24.46440022s-11.41672027 24.46440107-25.00805458 24.46440107z"/>
                            <Path Fill="{DynamicResource Brush.Brand.Secondary}" Data="M511.72817324 933.875c-13.59133347 0-24.46440107-10.87306677-24.46440106-24.46440107s10.87306677-24.46440107 24.46440106-24.46440022c77.74242874 0 150.59197842-30.44458795 206.04462013-85.35357615 54.90898819-54.90898819 85.35357614-128.30219055 85.35357614-206.04462012v-81.54800244c0-13.59133347 10.87306677-24.46440107 24.46440024-24.46440107s24.46440107 10.87306677 24.46440106 24.46440107v82.09165594c0 90.79010952-35.33746783 176.14368567-99.48856312 240.29478095-64.69474878 64.15109528-150.04832492 99.48856311-240.83843445 99.48856311z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource Str.App.TrayTitle}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0" />

            <!-- 中间：状态看板 -->
            <Grid Grid.Row="1" Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Status.DangerBg}"
                        BorderBrush="{DynamicResource Brush.Status.DangerBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.Tray.BannedMaliciousIps}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Surface.MutedText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BannedCount}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Status.Danger}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource Brush.Status.InfoBg}"
                        BorderBrush="{DynamicResource Brush.Status.InfoBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="5,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.Stat.TodayAttempts}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Surface.MutedText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayAttemptsCount}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Status.Info}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最近记录列表 -->
            <StackPanel Grid.Row="2" Margin="14,0,14,10">
                <TextBlock Text="{DynamicResource Str.Stat.RecentEvents}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Surface.MutedText}"
                           Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding RecentRecords}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface.StatCardBg}"
                                    BorderBrush="{DynamicResource Brush.Surface.BorderLight}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5"
                                    HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{Binding IsSuccess, Converter={StaticResource ResultToBrushConverter}}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IpAddress}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Surface.MutedText}">
                                            <Run Text="{Binding UserName}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding FailureReason}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.Surface.SubText}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{DynamicResource Str.Tray.NoRecentRecords}"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Surface.SubText}"
                           HorizontalAlignment="Center"
                           Margin="0,8"
                           Visibility="{Binding RecentRecords.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentRecords.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Separator Grid.Row="2" VerticalAlignment="Bottom" Margin="0" />

            <!-- 底部操作：退出 -->
            <StackPanel Grid.Row="3" Margin="8,4,8,8">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ExitCommand}"
                        HorizontalContentAlignment="Left"
                        MinHeight="36"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ExitToApp"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource Str.Tray.Exit}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
