<Window x:Class="RDPGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:convert="clr-namespace:RDPGuard.Convert"
        mc:Ignorable="d"
        Title="{DynamicResource Str.App.Title}"
        Height="740"
        Width="1160"
        MinHeight="620"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Background}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.FontSize="13"
        TextElement.FontWeight="Regular"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <convert:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <convert:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <convert:ResultToBrushConverter x:Key="ResultToBrushConverter" />
        <convert:BlockedToBrushConverter x:Key="BlockedToBrushConverter" />
        <convert:BlockedToTextConverter x:Key="BlockedToTextConverter" />

        <!-- 现代化 DataGrid 表头样式 -->
        <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.MutedText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="38" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <!-- 现代化 DataGrid 数据行样式 -->
        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
            <Setter Property="Height" Value="38" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.BorderLight}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶部应用栏与指标看板 -->
            <RowDefinition Height="Auto" />
            <!-- 选项卡与主体内容 -->
            <RowDefinition Height="*" />
            <!-- 底部状态条 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部 Header（现代化浅色卡片化风格，消除硬编码深色） -->
        <Border Grid.Row="0"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 应用信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Canvas Width="1024" Height="1024">
                            <Path Fill="{DynamicResource Brush.Brand.Primary}" Data="M754.74122089 512V359.23340839c0-15.22229397-12.50402729-27.72632126-27.72632045-27.72632045-50.0161083 0-97.85760342-19.57152036-133.19507125-54.90898901L531.2996936 214.07796417c-5.43653339-5.43653339-12.50402729-8.15480008-19.57152036-8.1548009v306.07683673h243.01304764z"/>
                            <Path Fill="{DynamicResource Brush.Brand.Secondary}" Data="M268.71512561 512v63.06378827c0 64.69474878 25.55170725 126.12757736 71.21858918 171.79445929 47.29784162 47.29784162 109.8179772 71.21858918 171.79445845 71.21858917V512H268.71512561z"/>
                            <Path Fill="{DynamicResource Brush.Brand.Secondary}" Data="M827.59076975 536.46440107c-13.59133347 0-24.46440107-10.87306677-24.46440024-24.46440107V314.11018078c0-6.52384039-4.89287989-11.41672027-11.41672028-11.4167211-71.76224268 0-139.17525732-27.72632126-189.73501996-78.82973575l-81.54800244-81.54800243c-3.26192019-2.71826669-6.52384039-3.26192019-8.69845359-3.26192021C498.13683979 139.05380129 487.26377218 128.18073452 487.26377218 114.58940106S498.13683979 90.125 511.72817324 90.125c16.30960016 0 30.98824063 6.52384039 42.40496174 17.39690717l81.54800244 81.54800243c41.31765472 41.31765472 96.77029642 64.15109528 155.48485831 64.15109528 33.16285464 0 60.34552158 27.18266775 60.34552158 60.34552241v197.8898192c0.5436535 14.13498697-10.32941327 25.00805374-23.92074756 25.00805458z"/>
                            <Path Fill="{DynamicResource Brush.Brand.Primary}" Data="M511.72817324 933.875c-90.79010952 0-176.14368567-35.33746783-240.29478093-99.48856311C207.28229702 769.69168811 171.9448292 684.33811197 171.9448292 593.54800244V314.11018078c0-33.16285464 27.18266775-60.34552158 60.34552157-60.3455224 58.71456189 0 114.16720358-22.83344055 155.48485831-64.15109527l81.54800326-81.54800244C480.73993261 96.64884039 495.96222577 90.125 511.72817324 90.125 525.31950672 90.125 536.19257431 100.99806677 536.19257431 114.58940106S525.31950672 139.05380129 511.72817324 139.05380129c-1.63095968 0-4.89287989 0.5436535-8.15480007 3.26192021l-81.54800244 81.54800243C371.46560892 274.96713926 304.05259344 302.69345968 232.29035078 302.69345968c-6.52384039 0-11.41672027 4.89287989-11.41672029 11.4167211v279.43782166c0 77.74242874 30.44458795 150.59197842 85.35357614 206.04462012s128.30219055 85.35357614 206.04462013 85.35357615c13.59133347 0 24.46440107 10.87306677 24.46440106 24.46440022s-11.41672027 24.46440107-25.00805458 24.46440107z"/>
                            <Path Fill="{DynamicResource Brush.Brand.Secondary}" Data="M511.72817324 933.875c-13.59133347 0-24.46440107-10.87306677-24.46440106-24.46440107s10.87306677-24.46440107 24.46440106-24.46440022c77.74242874 0 150.59197842-30.44458795 206.04462013-85.35357615 54.90898819-54.90898819 85.35357614-128.30219055 85.35357614-206.04462012v-81.54800244c0-13.59133347 10.87306677-24.46440107 24.46440024-24.46440107s24.46440107 10.87306677 24.46440106 24.46440107v82.09165594c0 90.79010952-35.33746783 176.14368567-99.48856312 240.29478095-64.69474878 64.15109528-150.04832492 99.48856311-240.83843445 99.48856311z"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.App.Name}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBlock Text="{DynamicResource Str.App.Subtitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Surface.MutedText}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 统计卡片 (现代化徽章风格，消除硬编码色值) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="24,0,0,0">
                    <Border Background="{DynamicResource Brush.Status.InfoBg}"
                            BorderBrush="{DynamicResource Brush.Status.InfoBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="IpNetworkOutline"
                                                     Foreground="{DynamicResource Brush.Status.Info}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Stat.TotalIps}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Surface.MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalUniqueIps}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Status.Info}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.Status.WarningBg}"
                            BorderBrush="{DynamicResource Brush.Status.WarningBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertOctagramOutline"
                                                     Foreground="{DynamicResource Brush.Status.Warning}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Stat.FailedRecords}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Surface.MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalFailedCount}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Status.Warning}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.Status.DangerBg}"
                            BorderBrush="{DynamicResource Brush.Status.DangerBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Cancel"
                                                     Foreground="{DynamicResource Brush.Status.Danger}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Stat.BannedIps}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Surface.MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalBannedCount}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Status.Danger}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 顶部快捷操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ScanHistoryCommand}"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource Str.Action.ScanHistory}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="History" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Action.ScanHistory}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding RefreshAllCommand}"
                            ToolTip="{DynamicResource Str.Action.Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Action.Refresh}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部主体区域 -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 搜索与选项卡切换工具栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 现代分段 Tab 切换器 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Surface.SegmentedBg}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                     Height="32"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AggregatedIps}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBoxOutline" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Str.Tab.AggregatedIps}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                     Height="32"
                                     Margin="4,0,0,0"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=RealtimeLogs}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Str.Tab.RealtimeLogs}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                     Height="32"
                                     Margin="4,0,0,0"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BannedList}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldLockOutline" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Str.Tab.BannedList}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                     Height="32"
                                     Margin="4,0,0,0"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Settings}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Str.Tab.Settings}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- 现代轻量搜索框 -->
                <Border Grid.Column="2"
                        Background="{DynamicResource MaterialDesignPaper}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,0"
                        Height="38"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Magnify"
                                                 Foreground="{DynamicResource Brush.Surface.SubText}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"/>
                        <TextBox Width="200"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Str.Search.Placeholder}"
                                 BorderThickness="0"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding ClearSearchCommand}"
                                Width="24"
                                Height="24"
                                Padding="0"
                                ToolTip="{DynamicResource Str.Action.ClearSearch}"
                                Foreground="{DynamicResource Brush.Surface.SubText}">
                            <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 内容面板区 -->
            <Grid Grid.Row="1">
                <!-- 1. IP 聚合显示列表（按相同 IP 聚合） -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="AggregatedIps">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <DataGrid ItemsSource="{Binding AggregatedIps}"
                              SelectedItem="{Binding SelectedAggregatedIp}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              FrozenColumnCount="3"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              GridLinesVisibility="None"
                              materialDesign:DataGridAssist.CellPadding="12,6"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource MaterialDesignDivider}"
                              Background="{DynamicResource MaterialDesignPaper}"
                              AlternatingRowBackground="{DynamicResource Brush.Surface.Background}"
                              HeadersVisibility="Column"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- 操作列 (固定在最左侧第一列，立即可见与操作) -->
                            <DataGridTemplateColumn Header="{DynamicResource Str.Grid.Action}" Width="145" MinWidth="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 封禁按钮 -->
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Background="{DynamicResource Brush.Status.DangerBg}"
                                                    BorderBrush="{DynamicResource Brush.Status.DangerBorder}"
                                                    Foreground="{DynamicResource Brush.Status.Danger}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.BanIpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding IpAddress}"
                                                    Visibility="{Binding IsBlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ShieldAlert" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{DynamicResource Str.Action.Ban}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 解封按钮 -->
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Background="{DynamicResource Brush.Status.SuccessBg}"
                                                    BorderBrush="{DynamicResource Brush.Status.SuccessBorder}"
                                                    Foreground="{DynamicResource Brush.Status.Success}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    Command="{Binding DataContext.UnbanIpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding IpAddress}"
                                                    Visibility="{Binding IsBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="LockOpenOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{DynamicResource Str.Action.Unban}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- IP 地址 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.IpAddress}"
                                                Binding="{Binding IpAddress}"
                                                FontWeight="Bold"
                                                Width="140"
                                                MinWidth="120" />

                            <!-- 封禁状态 -->
                            <DataGridTemplateColumn Header="{DynamicResource Str.Grid.ProtectionStatus}" Width="88" MinWidth="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding IsBlocked, Converter={StaticResource BlockedToBrushConverter}}">
                                            <TextBlock Text="{Binding IsBlocked, Converter={StaticResource BlockedToTextConverter}}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 总尝试次数 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.TotalAttempts}"
                                                Binding="{Binding TotalAttempts}"
                                                Width="85"
                                                MinWidth="75" />

                            <!-- 成功次数 -->
                            <DataGridTemplateColumn Header="{DynamicResource Str.Grid.SuccessCount}" Width="75" MinWidth="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SuccessCount}"
                                                   Foreground="{DynamicResource Brush.Status.Success}"
                                                   FontWeight="SemiBold" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 失败次数 -->
                            <DataGridTemplateColumn Header="{DynamicResource Str.Grid.FailedCount}" Width="75" MinWidth="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FailedCount}"
                                                   Foreground="{DynamicResource Brush.Status.Danger}"
                                                   FontWeight="Bold" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 尝试过的用户名集合 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.TargetUsers}"
                                                Binding="{Binding AttemptedUserNames}"
                                                Width="150"
                                                MinWidth="120" />

                            <!-- 首次尝试时间 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.FirstSeen}"
                                                Binding="{Binding FirstAttemptTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                Width="140"
                                                MinWidth="130" />

                            <!-- 最后尝试时间 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.LastSeen}"
                                                Binding="{Binding LastAttemptTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                Width="140"
                                                MinWidth="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 2. 实时登录流水（成功和失败） -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="RealtimeLogs">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <DataGrid ItemsSource="{Binding RealtimeRecords}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              FrozenColumnCount="3"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              GridLinesVisibility="None"
                              materialDesign:DataGridAssist.CellPadding="12,6"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource MaterialDesignDivider}"
                              Background="{DynamicResource MaterialDesignPaper}"
                              AlternatingRowBackground="{DynamicResource Brush.Surface.Background}"
                              HeadersVisibility="Column"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- 快捷操作 (固定在最左侧第一列，立即可见与操作) -->
                            <DataGridTemplateColumn Header="{DynamicResource Str.Grid.Action}" Width="105" MinWidth="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Background="{DynamicResource Brush.Status.DangerBg}"
                                                BorderBrush="{DynamicResource Brush.Status.DangerBorder}"
                                                Foreground="{DynamicResource Brush.Status.Danger}"
                                                Height="26"
                                                Padding="8,0"
                                                Command="{Binding DataContext.BanIpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding IpAddress}">
                                            <TextBlock Text="{DynamicResource Str.Action.Ban}" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 时间 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.EventTime}"
                                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                Width="145" />

                            <!-- IP 地址 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.RemoteIp}"
                                                Binding="{Binding IpAddress}"
                                                FontWeight="Bold"
                                                Width="130" />

                            <!-- 状态 -->
                            <DataGridTemplateColumn Header="{DynamicResource Str.Grid.AuthResult}" Width="78">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding IsSuccess, Converter={StaticResource ResultToBrushConverter}}">
                                            <TextBlock Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource Str.Status.Failed}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                <Setter Property="Text" Value="{DynamicResource Str.Status.Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 端口 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.SourcePort}"
                                                Binding="{Binding Port}"
                                                Width="70" />

                            <!-- 用户名 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.TargetUser}"
                                                Binding="{Binding UserName}"
                                                FontWeight="SemiBold"
                                                Width="120" />

                            <!-- 域名 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.DomainName}"
                                                Binding="{Binding DomainName}"
                                                Width="100" />

                            <!-- 类型 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.LogonType}"
                                                Binding="{Binding LogonTypeDescription}"
                                                Width="100" />

                            <!-- 失败原因/状态码 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.FailureReason}"
                                                Binding="{Binding FailureReason}"
                                                Width="160" />

                            <!-- 事件来源 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.EventSource}"
                                                Binding="{Binding EventSource}"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 3. 黑名单管理 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="BannedList">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 手动封禁工具栏 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource MaterialDesignPaper}"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str.Banned.ManualLabel}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Margin="0,0,10,0"/>
                            <TextBox Width="200"
                                     Text="{Binding ManualBanIpInput, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Str.Banned.ManualPlaceholder}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource Brush.Status.Danger}"
                                    BorderBrush="{DynamicResource Brush.Status.Danger}"
                                    Command="{Binding ManualBanCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldLock" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource Str.Banned.AddToFirewall}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 黑名单表格 -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding BannedIps}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              FrozenColumnCount="2"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              GridLinesVisibility="None"
                              materialDesign:DataGridAssist.CellPadding="12,6"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource MaterialDesignDivider}"
                              Background="{DynamicResource MaterialDesignPaper}"
                              AlternatingRowBackground="{DynamicResource Brush.Surface.Background}"
                              HeadersVisibility="Column"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- 操作列 (固定在最左侧第一列，立即可见与操作) -->
                            <DataGridTemplateColumn Header="{DynamicResource Str.Grid.Action}" Width="150" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Background="{DynamicResource Brush.Status.SuccessBg}"
                                                BorderBrush="{DynamicResource Brush.Status.SuccessBorder}"
                                                Foreground="{DynamicResource Brush.Status.Success}"
                                                Height="26"
                                                Padding="10,0"
                                                Command="{Binding DataContext.UnbanIpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding IpAddress}">
                                            <TextBlock Text="{DynamicResource Str.Banned.UnbanAndRemove}" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 被封禁 IP 地址 -->
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.IpAddress}"
                                                Binding="{Binding IpAddress}"
                                                FontWeight="Bold"
                                                Width="160"
                                                MinWidth="130" />

                            <DataGridTextColumn Header="{DynamicResource Str.Grid.BanTime}"
                                                Binding="{Binding BanTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                Width="180" />

                            <DataGridTextColumn Header="{DynamicResource Str.Grid.BanReason}"
                                                Binding="{Binding Reason}"
                                                Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 4. 设置与自启 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left" Margin="10,0">
                            <!-- 开机自启设置卡片 -->
                            <Border Background="{DynamicResource MaterialDesignPaper}"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,0,16"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str.Setting.AutoStartTitle}" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource Str.Setting.AutoStartDesc}"
                                                   Foreground="{DynamicResource Brush.Surface.MutedText}" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding IsLaunchOnSysPowerOn}"
                                                  Command="{Binding ToggleAutoStartCommand}"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 自动封禁阈值设置 -->
                            <Border Background="{DynamicResource MaterialDesignPaper}"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,0,16"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Setting.AutoBlockTitle}" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="{DynamicResource Str.Setting.AutoBlockDesc}"
                                               Foreground="{DynamicResource Brush.Surface.MutedText}" FontSize="12" Margin="0,4,0,12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <TextBlock Text="{DynamicResource Str.Setting.ThresholdLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox Width="80"
                                                 Text="{Binding AutoBanThreshold, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="8,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str.Setting.ThresholdRemark}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Surface.SubText}" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <TextBlock Text="{DynamicResource Str.Setting.WindowLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox Width="80"
                                                 Text="{Binding AutoBanWindowMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="8,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str.Setting.WindowRemark}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Surface.SubText}" FontSize="11"/>
                                    </StackPanel>

                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding SaveSettingsCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource Str.Setting.SavePolicy}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 日志清理 -->
                            <Border Background="{DynamicResource MaterialDesignPaper}"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,0,16"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Setting.DbMaintainTitle}" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="{DynamicResource Str.Setting.DbMaintainDesc}"
                                               Foreground="{DynamicResource Brush.Surface.MutedText}" FontSize="12" Margin="0,4,0,12"/>

                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="{DynamicResource Brush.Status.Danger}"
                                            BorderBrush="{DynamicResource Brush.Status.Danger}"
                                            Command="{Binding ClearAllRecordsCommand}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Str.Setting.ClearAllLogs}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- 底部轻提示 Snackbar -->
        <materialDesign:Snackbar Grid.Row="2"
                                 MessageQueue="{Binding SnackbarMessageQueue}" />

        <!-- 遮罩 Loading -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="{DynamicResource Brush.Surface.Overlay}"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Value="0"
                                 IsIndeterminate="True"
                                 Width="40"
                                 Height="40"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding BusyMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
