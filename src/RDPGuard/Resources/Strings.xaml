<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 应用标题与标识 -->
    <sys:String x:Key="Str.App.Title">RDP守护</sys:String>
    <sys:String x:Key="Str.App.Name">RDP守护</sys:String>
    <sys:String x:Key="Str.App.Subtitle">智能防火墙拦截</sys:String>
    <sys:String x:Key="Str.App.TrayTitle">RDP守护</sys:String>

    <!-- 顶部概览统计 -->
    <sys:String x:Key="Str.Stat.TotalIps">RDP IP</sys:String>
    <sys:String x:Key="Str.Stat.FailedRecords">失败记录</sys:String>
    <sys:String x:Key="Str.Stat.BannedIps">封禁 IP</sys:String>
    <sys:String x:Key="Str.Stat.TodayAttempts">今日登录尝试</sys:String>
    <sys:String x:Key="Str.Stat.RecentEvents">最新远程登录事件</sys:String>

    <!-- 操作与按钮 -->
    <sys:String x:Key="Str.Action.ScanHistory">扫描历史日志</sys:String>
    <sys:String x:Key="Str.Action.Refresh">刷新</sys:String>
    <sys:String x:Key="Str.Action.Ban">封禁 IP</sys:String>
    <sys:String x:Key="Str.Action.Unban">解封 IP</sys:String>
    <sys:String x:Key="Str.Action.ClearSearch">清空搜索</sys:String>
    <sys:String x:Key="Str.Action.ClearFirewallRule">一键清空防护规则</sys:String>
    <sys:String x:Key="Str.Action.ClearAllHistory">清空全部历史记录</sys:String>
    <sys:String x:Key="Str.Action.SaveSettings">保存设置</sys:String>
    <sys:String x:Key="Str.Action.OpenControlPanel">打开控制面板</sys:String>
    <sys:String x:Key="Str.Action.Exit">退出</sys:String>

    <!-- 选项卡分类 -->
    <sys:String x:Key="Str.Tab.AggregatedIps">聚合分析</sys:String>
    <sys:String x:Key="Str.Tab.RealtimeLogs">实时登录记录</sys:String>
    <sys:String x:Key="Str.Tab.BannedList">黑名单管理</sys:String>
    <sys:String x:Key="Str.Tab.Settings">设置</sys:String>

    <!-- 搜索占位符 -->
    <sys:String x:Key="Str.Search.Placeholder">搜索 IP地址 / 账号...</sys:String>

    <!-- DataGrid 表头列名 -->
    <sys:String x:Key="Str.Grid.Action">操作</sys:String>
    <sys:String x:Key="Str.Grid.IpAddress">IP地址</sys:String>
    <sys:String x:Key="Str.Grid.RemoteIp">远程 IP</sys:String>
    <sys:String x:Key="Str.Grid.ProtectionStatus">防护状态</sys:String>
    <sys:String x:Key="Str.Grid.TotalAttempts">总尝试次数</sys:String>
    <sys:String x:Key="Str.Grid.SuccessCount">成功次数</sys:String>
    <sys:String x:Key="Str.Grid.FailedCount">失败次数</sys:String>
    <sys:String x:Key="Str.Grid.FirstSeen">首次活跃时间</sys:String>
    <sys:String x:Key="Str.Grid.LastSeen">最后尝试时间</sys:String>
    <sys:String x:Key="Str.Grid.TargetUsers">常登账号</sys:String>
    <sys:String x:Key="Str.Grid.EventTime">发生时间</sys:String>
    <sys:String x:Key="Str.Grid.AuthResult">认证结果</sys:String>
    <sys:String x:Key="Str.Grid.TargetUser">登录账号</sys:String>
    <sys:String x:Key="Str.Grid.DomainName">域 / 计算机</sys:String>
    <sys:String x:Key="Str.Grid.LogonType">连接模式</sys:String>
    <sys:String x:Key="Str.Grid.SourcePort">远程端口</sys:String>
    <sys:String x:Key="Str.Grid.FailureReason">原因说明 / 错误代码</sys:String>
    <sys:String x:Key="Str.Grid.EventSource">Windows 事件源</sys:String>
    <sys:String x:Key="Str.Grid.BanTime">封禁生效时间</sys:String>
    <sys:String x:Key="Str.Grid.BanReason">封禁原因说明</sys:String>

    <!-- 黑名单页面特定文本 -->
    <sys:String x:Key="Str.Banned.ManualLabel">手动封禁 IP：</sys:String>
    <sys:String x:Key="Str.Banned.ManualPlaceholder">例如: 192.168.1.100</sys:String>
    <sys:String x:Key="Str.Banned.AddToFirewall">添加到防火墙封禁</sys:String>
    <sys:String x:Key="Str.Banned.UnbanAndRemove">解封并移出黑名单</sys:String>

    <!-- 设置模块文本 -->
    <sys:String x:Key="Str.Setting.AutoStartTitle">开机以最高管理员权限自启动</sys:String>
    <sys:String x:Key="Str.Setting.AutoStartDesc">使用 Windows 任务计划程序注册，无需 UAC 弹窗即可随系统开机自动后台防护。</sys:String>
    <sys:String x:Key="Str.Setting.AutoBlockTitle">暴力破解自动防护策略</sys:String>
    <sys:String x:Key="Str.Setting.AutoBlockDesc">当同一外部 IP 登录失败尝试达到阈值时，自动调用系统防火墙阻断入站流量。</sys:String>
    <sys:String x:Key="Str.Setting.ThresholdLabel">失败封禁阈值（次）：</sys:String>
    <sys:String x:Key="Str.Setting.ThresholdRemark">（设为 0 表示仅手动封禁）</sys:String>
    <sys:String x:Key="Str.Setting.SavePolicy">保存策略设置</sys:String>
    <sys:String x:Key="Str.Setting.DbMaintainTitle">数据库维护</sys:String>
    <sys:String x:Key="Str.Setting.DbMaintainDesc">清空本地 SQLite 数据库中记录的所有登录审计流水。</sys:String>
    <sys:String x:Key="Str.Setting.ClearAllLogs">清空本地所有流水记录</sys:String>

    <!-- 托盘控件特定文本 -->
    <sys:String x:Key="Str.Tray.OpenConsoleTooltip">点击打开主控制台</sys:String>
    <sys:String x:Key="Str.Tray.BannedMaliciousIps">已封禁恶意 IP</sys:String>
    <sys:String x:Key="Str.Tray.NoRecentRecords">暂无最新远程登录事件</sys:String>
    <sys:String x:Key="Str.Tray.OpenPanel">打开控制面板</sys:String>
    <sys:String x:Key="Str.Tray.Exit">退出</sys:String>

    <!-- 防护与结果状态徽章文本 -->
    <sys:String x:Key="Str.Status.Blocked">已封禁</sys:String>
    <sys:String x:Key="Str.Status.Active">正常</sys:String>
    <sys:String x:Key="Str.Status.Success">成功</sys:String>
    <sys:String x:Key="Str.Status.Failed">失败</sys:String>
    <sys:String x:Key="Str.Status.Unknown">未知</sys:String>

    <!-- 弹窗与确认对话框文案 -->
    <sys:String x:Key="Str.Dialog.ConfirmBanTitle">确认封禁</sys:String>
    <sys:String x:Key="Str.Dialog.ConfirmBanMsg">是否确认封禁该 IP ({0})？</sys:String>
    <sys:String x:Key="Str.Dialog.ConfirmUnbanTitle">确认解封</sys:String>
    <sys:String x:Key="Str.Dialog.ConfirmUnbanMsg">是否确认从防火墙解除封禁 IP ({0})？</sys:String>
    <sys:String x:Key="Str.Dialog.ConfirmClearRulesTitle">确认清空</sys:String>
    <sys:String x:Key="Str.Dialog.ConfirmClearRulesMsg">确定要从防火墙清空所有封禁规则吗？</sys:String>
    <sys:String x:Key="Str.Dialog.ConfirmClearHistoryTitle">清空确认</sys:String>
    <sys:String x:Key="Str.Dialog.ConfirmClearHistoryMsg">确定要清空本地所有 RDP 登录审计记录吗？（注意：不会清除 Windows 系统自带日志）</sys:String>
    <sys:String x:Key="Str.Dialog.ScanCompleteTitle">扫描完成</sys:String>
    <sys:String x:Key="Str.Dialog.ScanCompleteMsg">扫描完成！已同步导入 {0} 条远程登录记录。</sys:String>
    <sys:String x:Key="Str.Dialog.SaveSuccessTitle">保存成功</sys:String>
    <sys:String x:Key="Str.Dialog.SaveSuccessMsg">配置已保存并生效。</sys:String>

</ResourceDictionary>
