<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础调色板 (Palette Colors) -->
    <Color x:Key="Color.Success">#16A34A</Color>
    <Color x:Key="Color.SuccessBg">#F0FDF4</Color>
    <Color x:Key="Color.SuccessBorder">#BBF7D0</Color>

    <Color x:Key="Color.Danger">#DC2626</Color>
    <Color x:Key="Color.DangerBg">#FEF2F2</Color>
    <Color x:Key="Color.DangerBorder">#FECACA</Color>

    <Color x:Key="Color.Warning">#D97706</Color>
    <Color x:Key="Color.WarningBg">#FFFBEB</Color>
    <Color x:Key="Color.WarningBorder">#FDE68A</Color>

    <Color x:Key="Color.Info">#0284C7</Color>
    <Color x:Key="Color.InfoBg">#F0F9FF</Color>
    <Color x:Key="Color.InfoBorder">#BAE6FD</Color>

    <!-- 品牌与图标色 (Brand Colors) -->
    <Color x:Key="Color.Brand.Primary">#920783</Color>
    <Color x:Key="Color.Brand.Secondary">#601986</Color>
    <Color x:Key="Color.Overlay">#80000000</Color>

    <Color x:Key="Color.SurfaceBg">#F8FAFC</Color>
    <Color x:Key="Color.CardBg">#FFFFFF</Color>
    <Color x:Key="Color.Border">#E2E8F0</Color>
    <Color x:Key="Color.BorderLight">#F1F5F9</Color>
    <Color x:Key="Color.MutedText">#64748B</Color>
    <Color x:Key="Color.SubText">#94A3B8</Color>
    <Color x:Key="Color.BodyText">#1E293B</Color>

    <!-- 语义状态画刷 (Semantic Status Brushes) -->
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Status.SuccessBg" Color="{StaticResource Color.SuccessBg}" />
    <SolidColorBrush x:Key="Brush.Status.SuccessBorder" Color="{StaticResource Color.SuccessBorder}" />

    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Status.DangerBg" Color="{StaticResource Color.DangerBg}" />
    <SolidColorBrush x:Key="Brush.Status.DangerBorder" Color="{StaticResource Color.DangerBorder}" />

    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.WarningBg" Color="{StaticResource Color.WarningBg}" />
    <SolidColorBrush x:Key="Brush.Status.WarningBorder" Color="{StaticResource Color.WarningBorder}" />

    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.Status.InfoBg" Color="{StaticResource Color.InfoBg}" />
    <SolidColorBrush x:Key="Brush.Status.InfoBorder" Color="{StaticResource Color.InfoBorder}" />

    <!-- 品牌与图标画刷 -->
    <SolidColorBrush x:Key="Brush.Brand.Primary" Color="{StaticResource Color.Brand.Primary}" />
    <SolidColorBrush x:Key="Brush.Brand.Secondary" Color="{StaticResource Color.Brand.Secondary}" />
    <SolidColorBrush x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Overlay}" />

    <!-- 界面表面与结构画刷 (Surface & Structural Brushes) -->
    <SolidColorBrush x:Key="Brush.Surface.Background" Color="{StaticResource Color.SurfaceBg}" />
    <SolidColorBrush x:Key="Brush.Surface.HeaderBackground" Color="{StaticResource Color.CardBg}" />
    <SolidColorBrush x:Key="Brush.Surface.CardBackground" Color="{StaticResource Color.CardBg}" />
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Surface.BorderLight" Color="{StaticResource Color.BorderLight}" />
    <SolidColorBrush x:Key="Brush.Surface.MutedText" Color="{StaticResource Color.MutedText}" />
    <SolidColorBrush x:Key="Brush.Surface.SubText" Color="{StaticResource Color.SubText}" />
    <SolidColorBrush x:Key="Brush.Surface.BodyText" Color="{StaticResource Color.BodyText}" />

    <!-- 统计卡片与容器画刷 -->
    <SolidColorBrush x:Key="Brush.Surface.StatCardBg" Color="{StaticResource Color.SurfaceBg}" />
    <SolidColorBrush x:Key="Brush.Surface.SegmentedBg" Color="{StaticResource Color.BorderLight}" />

</ResourceDictionary>
